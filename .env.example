# Read when the server starts; Dokploy sets these per environment.
# Without CMS_URL the site reads the sandbox CMS, whose published content needs no token.

# Keycloak client of this site, which is also its tenant on the CMS
KEYCLOAK_CLIENT_ID=frontend-yildizjam
KEYCLOAK_CLIENT_SECRET=
# production: https://e.yildizskylab.com/realms/e-skylab
KEYCLOAK_ISSUER=https://e.yildizskylab.com/realms/e-skylab-sandbox

NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=

# Locally through `npm run dev`'s proxy to the sandbox API (next.config.ts): the CMS editor in
# the browser only talks to localhost, since the edge does not let http://localhost:3000 call
# the club's hosts. Change the port along with the dev server's.
# production: https://api.yildizskylab.com/api (the SDK adds /cms itself)
CMS_URL=http://localhost:3000/sandbox-api/api

# Core, for the CMS image bridge (server to server). The image build fixes it per environment;
# locally it is read when `npm run dev` starts.
# production: https://api.yildizskylab.com
API_BASE_URL=https://sandbox-api.yildizskylab.com
